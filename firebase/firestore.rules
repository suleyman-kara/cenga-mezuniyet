rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    match /sessions/{sid} {
      // Giris yapmis (anonim dahil) herkes oturumu okuyabilir.
      allow read: if signedIn();
      // Oturumu olusturan kendi uid'sini hostUid yapar.
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      // Guncelleme/silme sadece host; hostUid degistirilemez.
      allow update: if signedIn() && resource.data.hostUid == request.auth.uid
                    && request.resource.data.hostUid == resource.data.hostUid;
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /votes/{voteId} {
        function session() { return get(/databases/$(database)/documents/sessions/$(sid)).data; }
        function isHost() { return signedIn() && session().hostUid == request.auth.uid; }
        // Belge kimligi tam olarak "<decKey>__<uid>" olmali.
        function ownId() { return signedIn() && voteId == session().decKey + '__' + request.auth.uid; }
        // Okuma icin: kimligin son parcasi "__<uid>" ise bu seyircinin kendi oyudur.
        function isOwnDoc() {
          return signedIn()
            && voteId.size() > request.auth.uid.size() + 2
            && voteId[voteId.size() - request.auth.uid.size() - 2 : voteId.size()] == '__' + request.auth.uid;
        }
        function validVote() {
          let d = request.resource.data;
          return d.keys().hasOnly(['o', 'at']) && d.keys().hasAll(['o', 'at'])
            && d.o is int && d.o >= 0 && d.o < session().n
            && d.at == request.time;
        }

        allow get: if isHost() || isOwnDoc();
        allow list: if isHost();

        // Olusturma ve guncelleme (oy degistirme) izinli; silme yasak.
        allow create, update: if ownId()
          && session().phase == 'vote'
          // Host oyunu duraklattiysa (paused:true) oy verilemez; alan yoksa false sayilir.
          && session().get('paused', false) != true
          && request.time < session().closesAt + duration.value(1, 's')
          && validVote();
        allow delete: if false;
      }

      // Telefon kumandasi (yalnizca sunucu icin). Belge kimligi = host'un urettigi gizli anahtar (20+ karakter);
      // kimligi bilmek "okuma + bir kerelik eslesme" yetkisidir. Eslesen telefon (owner) komut yazabilir.
      match /remotes/{rid} {
        function rSession() { return get(/databases/$(database)/documents/sessions/$(sid)).data; }
        function rIsHost() { return signedIn() && rSession().hostUid == request.auth.uid; }
        // Host olmayan yalnizca owner'i null'dan kendi uid'sine cevirebilir; baska hicbir alan degismez.
        function claimsOwnership() {
          return signedIn()
            && resource.data.owner == null
            && request.resource.data.owner == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner']);
        }

        allow get: if signedIn();
        allow list: if rIsHost();
        allow create, delete: if rIsHost();
        allow update: if rIsHost() || claimsOwnership();

        match /cmds/{cid} {
          function remote() { return get(/databases/$(database)/documents/sessions/$(sid)/remotes/$(rid)).data; }
          function validCmd() {
            let d = request.resource.data;
            return ((d.keys().hasOnly(['c', 'at']) && d.keys().hasAll(['c', 'at']))
                    || (d.keys().hasOnly(['c', 'a', 'at']) && d.keys().hasAll(['c', 'a', 'at'])
                        && d.a is int && d.a >= 0 && d.a <= 3))
              && d.c is string
              && d.c in ['ileri', 'geri', 'duraklat', 'devam', 'kazan', 'bitir', 'ses', 'oto']
              && d.at == request.time;
          }

          allow create: if signedIn() && remote().owner == request.auth.uid && validCmd();
          allow get, list, delete: if rIsHost();
          allow update: if false;
        }
      }
    }

    // Diger tum yollar kapali.
    match /{document=**} { allow read, write: if false; }
  }
}
